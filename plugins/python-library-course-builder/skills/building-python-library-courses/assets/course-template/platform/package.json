{
  "name": "coursekit-learning-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "course:compile": "UV_CACHE_DIR=.uv-cache uv run python -m coursekit.cli compile course/source course",
    "course:check": "UV_CACHE_DIR=.uv-cache uv run python -m coursekit.cli check course/source course",
    "dev": "vinext dev",
    "learn": "node scripts/learn.mjs",
    "setup": "npm ci --ignore-scripts --no-audit --no-fund && uv sync --cache-dir .uv-cache --locked",
    "build": "vinext build",
    "test": "npm run course:check && npm run build && node --test tests/*.test.mjs",
    "test:runner": "UV_CACHE_DIR=.uv-cache uv run pytest runner/tests -q",
    "test:reference": "COURSEKIT_INTERNAL_RUN=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 UV_CACHE_DIR=.uv-cache PYTHONPATH=course/reference:course/starter uv run pytest -q course/starter course/tests/hidden",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .venv --ignore-pattern .uv-cache"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.4",
    "drizzle-orm": "0.45.3",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.61.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "8.3.1",
    "wrangler": "4.142.0"
  },
  "type": "module"
}
