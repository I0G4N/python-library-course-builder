  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/course-locale-v4.test.mjs tests/lesson-guide.test.mjs tests/web-contract.test.mjs",
